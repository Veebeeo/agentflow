# Copy to nhost/.secrets and fill in
# Generate the random values with:
#   openssl rand -hex 32          (secrets and admin secret)
#   openssl rand -base64 32       (AGENTFLOW_SECRETS_KEY, must be 32 bytes)

HASURA_GRAPHQL_ADMIN_SECRET='replace-me-hex32'
HASURA_GRAPHQL_JWT_SECRET='replace-me-at-least-32-characters-long'
NHOST_WEBHOOK_SECRET='replace-me-hex32'

# Local docker network address of the functions service.
# Cloud: https://<subdomain>.functions.<region>.nhost.run/v1

AGENTFLOW_FUNCTIONS_URL='http://functions:3000/v1'
AGENTFLOW_FUNCTIONS_SECRET='replace-me-hex32'
AGENTFLOW_SECRETS_KEY='replace-me-base64-32-bytes'

# LLM provider for llm_call steps. Leave LLM_API_KEY empty to run in stub mode,
# which returns a deterministic response after a disclosed artificial delay.

LLM_PROVIDER='groq'
LLM_API_KEY=''
LLM_MODEL='llama-3.3-70b-versatile'

GRAFANA_ADMIN_PASSWORD='some-random-string'

# Optional. Without it, notify steps are recorded as sent in dry-run mode.
SLACK_WEBHOOK_URL=''

# Optional egress allowlist for http_request steps, comma separated.
# Example: 'api.github.com,httpbin.org'
HTTP_ALLOWED_HOSTS=''
