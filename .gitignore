# ── Secrets ───────────────────────────────────────────────────────────
.secrets
.env
.env.local
.env.*.local

# ── Dependencies ──────────────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────────────
.next/
out/
dist/
*.tsbuildinfo

# ── Nhost local state ─────────────────────────────────────────────────
# Container volumes and CLI scratch data, regenerated by `nhost up`.
nhost/.nhost/

# ── Editor and OS ─────────────────────────────────────────────────────
# .vscode is committed deliberately: shared settings and extension
# recommendations belong in the repo. Everything else in it does not.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/
.DS_Store
Thumbs.db
*.swp

# ── Logs ──────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

# CLI runtime state at the repo root, regenerated by every `nhost up`.
.nhost/
