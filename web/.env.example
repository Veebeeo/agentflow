# Copy to web/.env.local
#
# Local Nhost stack (nhost up). Verify these against the URLs the CLI prints
# on startup; the subdomain is "local" in every one of them.
NEXT_PUBLIC_NHOST_AUTH_URL=https://local.auth.local.nhost.run/v1
NEXT_PUBLIC_NHOST_GRAPHQL_URL=https://local.hasura.local.nhost.run/v1/graphql
NEXT_PUBLIC_NHOST_STORAGE_URL=https://local.storage.local.nhost.run/v1
NEXT_PUBLIC_NHOST_FUNCTIONS_URL=https://local.functions.local.nhost.run/v1

# Nhost Cloud instead:
# NEXT_PUBLIC_NHOST_SUBDOMAIN=your-subdomain
# NEXT_PUBLIC_NHOST_REGION=ap-south-1
